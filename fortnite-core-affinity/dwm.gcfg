# Corrected dwm.exe block for PROC_PRIORITY.GCFG
# Original pinned DWM to cores 3-5 (GROUP:DWM) and 0-1 (GROUP:POWERSAVE),
# several threads at priority 15. Cores 1/3/5 are your dedicated Fortnite
# cores (GameThread/RenderThread/RHISubmission), so DWM was fighting the
# game on 3 of the 4 clean cores.
#
# Fix: retarget every DWM thread to core 0 (the general housekeeping /
# NIC core), off the clean cores 1/3/5/7 and off the sensitive audio(4)
# and GPU(6) cores. Priorities/boost/flags are left exactly as you had
# them -- only the affinity (was ALL/GROUP) and the park range (was 0,1 /
# 3,5) are changed. Single-core affinity (0) is a safe one-token form.
[dwm.exe,0,ALL,False,none,-1,-1,False,False,0,False,False,0,0]
amdxx64.dll+0xDA7B70=-15,0,True,-1,-1,-1,1,False,True
combase.dll+0x140C50=-15,0,True,-1,-1,-1,1,False,True
DispBroker.dll+0x37970=15,0,False,-1,-1,-1,2,False,False
DWM Compositor Thread=0,0,False,-1,-1,-1,0,False,False
DWM Kernel Sensor Thread=15,0,False,-1,-1,-1,2,False,False
DWM LPC Port Thread=-15,0,True,-1,-1,-1,1,False,False
DWM Manipulation Thread=-15,0,True,-1,-1,-1,1,False,True
DWM Master Input Thread=15,0,False,-1,-1,-1,2,False,False
DWM Token Thread=-2,0,True,-1,-1,-1,0,False,False
